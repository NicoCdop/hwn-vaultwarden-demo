# Vaultwarden environment variables — DEMO reference.
# Real values live in Railway service variables, NOT in this file.
# Full reference: https://github.com/dani-garcia/vaultwarden/blob/main/.env.template

# === REQUIRED ===

# Public URL of your instance. MUST include scheme. NO trailing slash.
DOMAIN=https://your-service.up.railway.app

# Argon2id PHC string. Generate with:
#   docker run --rm vaultwarden/server /vaultwarden hash
ADMIN_TOKEN=$argon2id$v=19$m=65540,t=3,p=4$...

# === RECOMMENDED ===

# Allow new user registration. Set to false after first registration in DEMO.
SIGNUPS_ALLOWED=true

# Allow inviting users from admin panel.
INVITATIONS_ALLOWED=true

# Restrict signups to specific email domains (comma-separated).
# SIGNUPS_DOMAINS_WHITELIST=example.com,another.com

# Logging. Use "info" by default, "debug" only for troubleshooting.
LOG_LEVEL=info

# === RAILWAY SPECIFIC ===

# Force container to run as root if you hit volume permission errors.
# RAILWAY_RUN_UID=0

# === OPTIONAL: SMTP (not needed for DEMO) ===
# SMTP_HOST=smtp.example.com
# SMTP_FROM=vaultwarden@example.com
# SMTP_FROM_NAME=Vaultwarden DEMO
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=

# === OPTIONAL: Postgres (recommended for prod, NOT for DEMO) ===
# DATABASE_URL=postgresql://user:pass@host:5432/vaultwarden

# === OPTIONAL: Hardening (consider for prod) ===
# LOGIN_RATELIMIT_MAX_BURST=10
# LOGIN_RATELIMIT_SECONDS=60
# ADMIN_RATELIMIT_MAX_BURST=10
# ADMIN_RATELIMIT_SECONDS=60
# SHOW_PASSWORD_HINT=false
